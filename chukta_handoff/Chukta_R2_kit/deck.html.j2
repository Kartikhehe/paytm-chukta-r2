     ('🔗 ERP / Bharat Connect integration only','Invoices for ERP-using distributors',2,4,'2/5',2,2,4,'Capture channel','a'),
     ('⭐ Chukta: bill inbox + voice + distributor-led + optional credit','Bundles the best of 2, 3, 4, 5',4,4,'5/5',3,3,3,'Recommend','g')
    ] %}
